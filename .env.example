# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave EMPTY for local development: the app runs an embedded Postgres (PGlite)
# stored in ./.data/pglite. No Docker, no server install.
# On Vercel set the pooled connection string from Neon (or any Postgres):
#   postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth (REQUIRED in production)
# ---------------------------------------------------------------------------
# 32+ random chars: openssl rand -base64 48
AUTH_SECRET=dev-only-insecure-secret-change-me-please-0123456789

# Public origin, used for cookies, QR payloads and links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Payments (optional locally - the mock provider is used when unset)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Notifications (optional - messages are logged and marked "simulated" when unset)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Ironhouse Gym <noreply@ironhouse.test>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Scheduled jobs (Vercel Cron sends this as a Bearer token)
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
SENTRY_DSN=
