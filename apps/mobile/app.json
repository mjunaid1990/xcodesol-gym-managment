{
  "expo": {
    "name": "Xcodesol Gym",
    "slug": "xcodesol-gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "xcodesol",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#07090c",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xcodesol.gym",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan gym door QR codes and class check-in passes.",
        "NSFaceIDUsageDescription": "Sign in quickly with Face ID (optional)."
      }
    },
    "android": {
      "package": "com.xcodesol.gym",
      "adaptiveIcon": {
        "backgroundColor": "#07090c"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "57b38459-b34e-488e-8e0a-0aca0ce5cd21"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "mjunaid1990"
  }
}
