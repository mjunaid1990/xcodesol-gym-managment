{
  "expo": {
    "name": "Ironhouse Gym",
    "slug": "ironhouse-gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ironhouse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#07090c",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ironhouse.gym",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan gym door QR codes and class check-in passes.",
        "NSFaceIDUsageDescription": "Sign in quickly with Face ID (optional)."
      }
    },
    "android": {
      "package": "com.ironhouse.gym",
      "adaptiveIcon": {
        "backgroundColor": "#07090c"
      },
      "permissions": ["CAMERA", "POST_NOTIFICATIONS"]
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "extra": {
      "router": { "origin": false },
      "eas": { "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID" }
    },
    "experiments": { "typedRoutes": false }
  }
}
