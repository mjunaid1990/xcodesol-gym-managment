{
  "name": "xcodesol-gym",
  "version": "1.0.0",
  "private": true,
  "description": "Gym management system: admin dashboard, member/trainer REST API, and Expo mobile app.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "tsx scripts/db.ts deploy && next build",
    "vercel-build": "tsx scripts/db.ts deploy && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:deploy": "tsx scripts/db.ts deploy",
    "db:reset": "tsx scripts/db.ts reset",
    "db:setup": "tsx scripts/db.ts reset",
    "db:studio": "drizzle-kit studio",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
